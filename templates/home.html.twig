{% extends 'layout.html.twig' %}

{% block title %}Gamble · Paris{% endblock %}

{% block content %}
    <header class="page-header">
        <p class="eyebrow">Gestion de paris</p>
        <h1>Vos paris</h1>
        <p class="identity">Connecté comme <strong>{{ user.twitchDisplayName }}</strong></p>
    </header>

    <section class="empty-state">
        <h2>Organisez vos paris privés</h2>
        <p>Créez un pari, proposez ses choix puis suivez son cycle de vie.</p>
    </section>

    {% if can_view_bets or can_view_contacts or can_view_groups or can_view_users %}
        <nav class="primary-navigation" aria-label="Navigation principale">
            {% if can_view_bets %}
                <a class="button button-primary" href="/bets">Gérer les paris</a>
            {% endif %}
            {% if can_view_contacts %}
                <a class="button button-primary" href="/contacts">Gérer les contacts</a>
            {% endif %}
            {% if can_view_groups %}
                <a class="button button-primary" href="/groups">Gérer les groupes</a>
            {% endif %}
            {% if can_view_users %}
                <a class="button button-primary" href="/admin/users">Gérer les utilisateurs</a>
            {% endif %}
        </nav>
    {% endif %}

    <form method="post" action="/auth/logout" class="logout-form">
        <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
        <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
        <button type="submit" class="button button-secondary">Se déconnecter</button>
    </form>
{% endblock %}