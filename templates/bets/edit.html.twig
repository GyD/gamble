{% extends 'layout.html.twig' %}

{% block title %}Modifier le pari · {{ app_name|default('Gamble') }}{% endblock %}

{% block content %}
    <header class="page-header page-header-row page-header-back">
        <div><h1>Modifier</h1></div>
        <a class="button button-secondary" href="/bets">Retour</a>
    </header>
    <form method="post" action="/bets/{{ bet.id }}" class="bet-form form-section">
        <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
        <div class="form-field"><label for="bet-question">Question</label><input id="bet-question" name="question" type="text" maxlength="255" value="{{ bet.question }}" required></div>
        <div class="form-field"><label for="bet-description">Description <span>(facultative)</span></label><textarea id="bet-description" name="description" maxlength="2000" rows="5">{{ bet.description }}</textarea></div>
        <div class="form-field"><label for="bet-closes-at">Date limite <span>(facultative)</span></label><input id="bet-closes-at" name="closes_at" type="datetime-local" value="{{ bet.closesAt ? bet.closesAt|date('Y-m-d\\TH:i') : '' }}"></div>
        <div class="form-field">
            <label for="bet-betting-mode">Mode de pari</label>
            <select id="bet-betting-mode" name="betting_mode" data-betting-mode{% if has_stakes %} disabled aria-describedby="bet-mode-help-{{ bet.bettingMode.value == 'fixed_odds' ? 'fixed-odds' : 'pari-mutuel' }}"{% else %} aria-describedby="bet-mode-help-fixed-odds bet-mode-help-pari-mutuel"{% endif %}>
                <option value="fixed_odds"{% if bet.bettingMode.value == 'fixed_odds' %} selected{% endif %}>Cotes fixes</option>
                <option value="pari_mutuel"{% if bet.bettingMode.value == 'pari_mutuel' %} selected{% endif %}>Pari mutuel</option>
            </select>
            {% if has_stakes %}
                {% include 'bets/_betting-mode-help.html.twig' with {mode: bet.bettingMode.value} %}
            {% else %}
                {% include 'bets/_betting-mode-help.html.twig' %}
            {% endif %}
            <p class="form-help">{{ has_stakes ? 'Des mises existent : le mode ne peut plus être modifié.' : 'Le mode ne pourra plus être modifié dès qu\'une mise existera.' }}</p>
            {% if has_stakes %}<input type="hidden" name="betting_mode" value="{{ bet.bettingMode.value }}">{% endif %}
        </div>
        <div class="form-field" data-fixed-odds-only{% if bet.bettingMode.value != 'fixed_odds' %} hidden{% endif %}>
            <label for="bet-odds-evolution-mode">Évolution des cotes</label>
            <select id="bet-odds-evolution-mode" name="odds_evolution_mode" data-odds-evolution-mode aria-describedby="bet-odds-evolution-help">
                {% for value, label in {'fixed': 'Fixe — les cotes restent celles que vous avez saisies', 'dynamic_low': 'Dynamique faible — les cotes bougent peu selon les mises', 'dynamic_normal': 'Dynamique modérée — équilibre recommandé', 'dynamic_high': 'Dynamique forte — les cotes suivent nettement les mises'} %}
                    <option value="{{ value }}"{% if bet.oddsEvolutionMode.value == value %} selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <p class="form-help" id="bet-odds-evolution-help">Détermine à quel point les cotes proposées aux prochains parieurs s'écartent de celles que vous avez saisies, en fonction des mises déjà prises. Une mise déjà placée garde sa cote.</p>
            {% include 'bets/_odds-evolution-help.html.twig' %}
        </div>
        <div class="form-field" data-mutuel-only{% if bet.bettingMode.value == 'fixed_odds' %} hidden{% endif %}>
            <label for="bet-mutuel-rate">Commission bookmaker (%)</label>
            <input id="bet-mutuel-rate" name="mutuel_percentage" type="number" min="0" max="25" step="0.01" value="{{ (bet.mutuelCommissionRateBps / 100)|number_format(2, '.', '') }}"{% if bet.bettingMode.value == 'fixed_odds' %} disabled{% endif %}>
            <p class="form-help">Entre 0 et 25 %. Cette commission est prélevée sur le pool à la clôture, avant redistribution.</p>
        </div>
        {% if bet.bettingMode.value == 'fixed_odds' %}
            <p class="form-help">Marge bookmaker : {{ bet.oddsMargin is null ? 'non calculable tant que tous les choix ne sont pas cotés' : (bet.oddsMargin * 100)|number_format(2, ',', ' ') ~ ' %' }} — elle découle des cotes elles-mêmes, rien n'est prélevé au règlement.</p>
        {% endif %}
        <fieldset class="bet-options"><legend>Choix</legend>
            <p class="form-help">{{ has_stakes ? 'Des mises existent : les choix ne peuvent plus être modifiés.' : 'Entre 2 et 20 choix uniques.' }}</p>
            <div class="bet-option-fields" data-option-fields>
                {% for option in bet.options %}<div class="form-field"><label for="bet-option-{{ loop.index }}">Choix {{ loop.index }}</label><input id="bet-option-{{ loop.index }}" name="options[]" type="text" maxlength="120" value="{{ option.label }}" required{% if has_stakes %} readonly{% endif %}><input class="bet-option-odds" name="odds[]" type="number" min="1.01" max="1000" step="0.01" value="{{ option.odds is null ? '' : option.odds|number_format(2, '.', '') }}" aria-label="Cote du choix {{ loop.index }}" data-fixed-odds-only data-odds-input{% if bet.bettingMode.value != 'fixed_odds' %} hidden disabled{% endif %}></div>{% endfor %}
            </div>
            {% if not has_stakes %}
                <div class="bet-options-actions">
                    <button class="button button-secondary" type="button" data-add-option>Ajouter un choix</button>
                </div>
            {% endif %}
            <p class="form-help" data-fixed-odds-only{% if bet.bettingMode.value != 'fixed_odds' %} hidden{% endif %}>Saisissez la cote de chaque choix, ou laissez-les toutes vides : un choix sans cote n'accepte aucune mise. La marge se lit dans les cotes elles-mêmes.</p>
        </fieldset>
        <button class="button button-primary" type="submit">Enregistrer</button>
    </form>
    {% if bet.bettingMode.value == 'fixed_odds' %}
        <p class="form-help"><a class="button button-secondary" href="/bets/{{ bet.id }}/odds">Ajuster les cotes</a> Consultez votre exposition choix par choix avant de recoter.</p>
    {% endif %}
    <script src="/assets/js/bet-options.js" defer></script>
    <script src="/assets/js/bet-market.js" defer></script>
{% endblock %}