
{% extends 'layout.html.twig' %}

{% block title %}Paris · {{ app_name|default('Gamble') }}{% endblock %}

{% block content %}
    <header class="page-header page-header-row page-header-back">
        <div><h1>Paris</h1></div>
        <a class="button button-secondary" href="/">Retour</a>
    </header>

    {% if saved %}<p class="notice notice-success" role="status">Modification enregistrée.</p>{% endif %}

    {% if can_create %}
        <details class="bet-create-panel form-section">
            <summary class="button button-primary">Créer un pari</summary>
            <form method="post" action="/bets" class="bet-form">
                <h2>Nouveau pari</h2>
                <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                <div class="form-field"><label for="bet-question">Question</label><input id="bet-question" name="question" type="text" maxlength="255" required></div>
                <div class="form-field"><label for="bet-description">Description <span>(facultative)</span></label><textarea id="bet-description" name="description" maxlength="2000" rows="4"></textarea></div>
                <div class="form-field"><label for="bet-closes-at">Date limite <span>(facultative)</span></label><input id="bet-closes-at" name="closes_at" type="datetime-local"></div>
                <div class="form-field">
                    <label for="bet-betting-mode">Mode de pari</label>
                    <select id="bet-betting-mode" name="betting_mode" data-betting-mode>
                        <option value="fixed_odds" selected>Cotes fixes</option>
                        <option value="pari_mutuel">Pari mutuel</option>
                    </select>
                    <p class="form-help">Le mode ne pourra plus être modifié dès qu'une mise existera.</p>
                </div>
                <div class="form-field" data-fixed-odds-only>
                    <label for="bet-odds-evolution-mode">Évolution des cotes</label>
                    <select id="bet-odds-evolution-mode" name="odds_evolution_mode">
                        <option value="fixed">Fixe — les mises ne modifient pas les probabilités</option>
                        <option value="dynamic_low">Dynamique faible</option>
                        <option value="dynamic_normal" selected>Dynamique modérée</option>
                        <option value="dynamic_high">Dynamique forte</option>
                    </select>
                </div>
                <div class="form-field" data-fixed-odds-only data-probability-presets hidden>
                    <label for="bet-probability-preset">Probabilités initiales</label>
                    <select id="bet-probability-preset" data-probability-preset>
                        <option value="50/50" selected>50 / 50</option>
                        <option value="52.5/47.5">52.5 / 47.5</option>
                        <option value="55/45">55 / 45</option>
                        <option value="60/40">60 / 40</option>
                        <option value="65/35">65 / 35</option>
                        <option value="70/30">70 / 30</option>
                        <option value="80/20">80 / 20</option>
                        <option value="">Personnalisé</option>
                    </select>
                    <p class="form-help">Les probabilités sont normalisées pour totaliser 100 %.</p>
                </div>
                <fieldset class="bet-options"><legend>Choix</legend>
                    <p class="form-help">Entre 2 et 20 choix uniques.</p>
                    <div class="bet-option-fields" data-option-fields>
                        <div class="form-field"><label for="bet-option-1">Choix 1</label><input id="bet-option-1" name="options[]" type="text" maxlength="120" required><input class="bet-option-probability" name="probabilities[]" type="number" min="0.01" max="99.99" step="0.01" value="50" aria-label="Probabilité du choix 1 en %" data-fixed-odds-only data-probability-input></div>
                        <div class="form-field"><label for="bet-option-2">Choix 2</label><input id="bet-option-2" name="options[]" type="text" maxlength="120" required><input class="bet-option-probability" name="probabilities[]" type="number" min="0.01" max="99.99" step="0.01" value="50" aria-label="Probabilité du choix 2 en %" data-fixed-odds-only data-probability-input></div>
                    </div>
                    <button class="button button-secondary" type="button" data-add-option>Ajouter un choix</button>
                </fieldset>
                <button class="button button-primary" type="submit">Créer et ouvrir</button>
            </form>
        </details>
    {% endif %}

    <div class="bet-list">
        {% for bet in bets %}
            <article class="bet-card">
                <div class="bet-card-header">
                    <h2><a href="/bets/{{ bet.id }}">{{ bet.question }}</a></h2>
                    <span class="status status-{{ bet.status.value }}">{{ {'open': 'Ouvert', 'closed': 'Fermé', 'settled': 'Réglé', 'cancelled': 'Annulé'}[bet.status.value] }}</span>
                </div>
                {% if bet.description %}<p>{{ bet.description }}</p>{% endif %}
                {% if bet.closesAt %}<p class="form-help">Date limite : {{ bet.closesAt|date('d/m/Y H:i') }}</p>{% endif %}
                <ol class="bet-option-list">
                    {% for option in bet.options %}
                        <li{% if option.id == bet.winningOptionId %} class="winning-option"{% endif %}>{{ option.label }} — {{ bet.status.value == 'settled' ? 'cote' : 'cote indicative' }} {{ option.odds is null ? '—' : option.odds|number_format(2, ',', ' ') }}{% if option.id == bet.winningOptionId %} — gagnant{% endif %}</li>
                    {% endfor %}
                </ol>

                <div class="card-actions">
                    {% if can_view_stakes %}<a class="button button-secondary" href="/bets/{{ bet.id }}/stakes">Voir les mises</a>{% endif %}
                    {% if bet.status.value == 'open' %}
                        {% if can_edit %}<a class="button button-secondary" href="/bets/{{ bet.id }}/edit">Modifier</a>{% endif %}
                        {% if can_close %}
                            <form method="post" action="/bets/{{ bet.id }}/close"><input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}"><button class="button button-primary" type="submit">Fermer</button></form>
                        {% endif %}
                        {% if can_cancel %}
                            <form method="post" action="/bets/{{ bet.id }}/cancel"><input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}"><button class="button button-danger" type="submit" onclick="return confirm('Annuler ce pari ? Les mises payées devront ensuite être remboursées.')">Annuler</button></form>
                        {% endif %}
                    {% elseif bet.status.value == 'closed' %}
                        {% if can_settle %}<form method="post" action="/bets/{{ bet.id }}/settle" class="settle-form">
                            <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                            <label for="winning-option-{{ bet.id }}">Choix gagnant</label>
                            <select id="winning-option-{{ bet.id }}" name="winning_option_id" required><option value="">Sélectionner</option>{% for option in bet.options %}<option value="{{ option.id }}">{{ option.label }}</option>{% endfor %}</select>
                            <button class="button button-primary" type="submit">Régler</button>
                        </form>{% endif %}
                        {% if can_cancel %}<form method="post" action="/bets/{{ bet.id }}/cancel"><input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}"><button class="button button-danger" type="submit" onclick="return confirm('Annuler ce pari ? Les mises payées devront ensuite être remboursées.')">Annuler</button></form>{% endif %}
                    {% elseif bet.status.value == 'cancelled' and can_cancel %}
                        <form method="post" action="/bets/{{ bet.id }}/delete"><input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}"><button class="button button-danger" type="submit" onclick="return confirm('Supprimer définitivement ce pari annulé ? Cette action est irréversible.')">Supprimer définitivement</button></form>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <section class="empty-state"><p>Aucun pari.</p></section>
        {% endfor %}
    </div>

    <script src="/assets/js/bet-options.js" defer></script>
    <script src="/assets/js/bet-market.js" defer></script>
{% endblock %}