{% extends 'layout.html.twig' %}

{% block title %}{{ bet.question }} · {{ app_name|default('Gamble') }}{% endblock %}

{% block content %}
    <header class="page-header page-header-row page-header-back">
        <div><h1>{{ bet.question }}</h1></div>
        <a class="button button-secondary" href="/bets">Retour</a>
    </header>

    <article class="bet-card">
        <div class="bet-card-header"><h2>Détails</h2><span class="status status-{{ bet.status.value }}">{{ {'open': 'Ouvert', 'closed': 'Fermé', 'settled': 'Réglé', 'cancelled': 'Annulé'}[bet.status.value] }}</span></div>
        {% if bet.description %}<p>{{ bet.description }}</p>{% endif %}
        {% if bet.closesAt %}<p class="form-help">Date limite : {{ bet.closesAt|date('d/m/Y H:i') }}</p>{% endif %}
        <p class="form-help">Mode : {{ bet.bettingMode.value == 'fixed_odds' ? 'Cotes fixes' : 'Pari mutuel' }}</p>
        {% include 'bets/_betting-mode-help.html.twig' with {mode: bet.bettingMode.value, variant: 'short'} %}
        {% if bet.bettingMode.value == 'fixed_odds' %}
            <p class="form-help">Marge bookmaker : {{ bet.oddsMargin is null ? '—' : (bet.oddsMargin * 100)|number_format(2, ',', ' ') ~ ' %' }} — elle découle des cotes que vous avez saisies, aucun prélèvement au règlement.</p>
        {% else %}
            <p class="form-help">Commission bookmaker : {{ (bet.mutuelCommissionRateBps / 100)|number_format(2, ',', ' ') }} % — prélevée sur le pool à la clôture.</p>
        {% endif %}
        <ol class="bet-option-list">{% for option in bet.options %}<li{% if option.id == bet.winningOptionId %} class="winning-option"{% endif %}>{{ option.label }} — {% if bet.status.value == 'settled' %}cote {{ option.finalOdds is null ? '—' : option.finalOdds|number_format(2, ',', ' ') }}{% else %}cote proposée {{ option.offeredOdds is null ? '—' : option.offeredOdds|number_format(2, ',', ' ') }}{% endif %}{% if option.id == bet.winningOptionId %} — gagnant{% endif %}</li>{% endfor %}</ol>
        {% if bet.status.value != 'settled' %}<p class="form-help">{% if bet.bettingMode.value == 'fixed_odds' %}La cote proposée est celle qui sera figée sur la prochaine mise. Un tiret signifie que ce choix n'est pas encore coté et n'accepte donc aucune mise.{% else %}Les cotes affichées sont indicatives et non garanties. Un tiret signifie qu'aucune mise n'a encore été placée sur ce choix.{% endif %}</p>{% endif %}
        {% if bet.status.value == 'settled' %}
            <p>
                <strong>Pot :</strong> {{ bet.finalPot|number_format(0, ',', ' ') }} $ ·
                <strong>Commission :</strong> {{ bet.finalBookmakerShare|number_format(0, ',', ' ') }} $ ·
                <strong>Redistribué :</strong> {{ bet.finalRedistributed|number_format(0, ',', ' ') }} $ ·
                <strong>Résultat bookmaker :</strong> {{ bet.finalBookmakerResult is null ? '—' : bet.finalBookmakerResult|number_format(0, ',', ' ') ~ ' $' }}
            </p>
            <p class="form-help">Pot : total des mises payées. Redistribué : montant versé aux gagnants. Résultat bookmaker : ce qu'il vous reste{% if bet.bettingMode.value == 'fixed_odds' %}, qui peut être négatif si les gains versés dépassent les mises encaissées{% endif %}.</p>
        {% endif %}

        <div class="card-actions">
            {% if can_view_stakes %}<a class="button button-secondary" href="/bets/{{ bet.id }}/stakes">Voir les mises</a>{% endif %}
            {% if bet.status.value == 'open' %}
                {% if can_edit %}<a class="button button-secondary" href="/bets/{{ bet.id }}/edit">Modifier</a>{% endif %}
                {% if can_edit and bet.bettingMode.value == 'fixed_odds' %}<a class="button button-secondary" href="/bets/{{ bet.id }}/odds">Ajuster les cotes</a>{% endif %}
                {% if can_close %}<form method="post" action="/bets/{{ bet.id }}/close"><input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}"><button class="button button-primary" type="submit">Fermer</button></form>{% endif %}
                {% if can_cancel %}<form method="post" action="/bets/{{ bet.id }}/cancel"><input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}"><button class="button button-danger" type="submit" onclick="return confirm('Annuler ce pari ? Les mises payées devront ensuite être remboursées.')">Annuler</button></form>{% endif %}
            {% elseif bet.status.value == 'closed' %}
                {% if can_settle %}<form method="post" action="/bets/{{ bet.id }}/settle" class="settle-form"><input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}"><label for="winning-option">Choix gagnant</label><select id="winning-option" name="winning_option_id" required><option value="">Sélectionner</option>{% for option in bet.options %}<option value="{{ option.id }}">{{ option.label }}</option>{% endfor %}</select><button class="button button-primary" type="submit">Régler</button></form>{% endif %}
                {% if can_cancel %}<form method="post" action="/bets/{{ bet.id }}/cancel"><input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}"><button class="button button-danger" type="submit" onclick="return confirm('Annuler ce pari ? Les mises payées devront ensuite être remboursées.')">Annuler</button></form>{% endif %}
            {% elseif bet.status.value == 'cancelled' and can_cancel %}
                <form method="post" action="/bets/{{ bet.id }}/delete"><input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}"><input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}"><button class="button button-danger" type="submit" onclick="return confirm('Supprimer définitivement ce pari annulé ? Cette action est irréversible.')">Supprimer définitivement</button></form>
            {% endif %}
        </div>
    </article>

    {% if bet.status.value == 'settled' and bet.winningOptionId %}
        <section class="bet-card" aria-labelledby="bet-winners-title">
            <h2 id="bet-winners-title">Gagnants</h2>
            {% if winners is not empty %}
                <div class="winner-table-wrapper" role="region" aria-labelledby="bet-winners-title" tabindex="0">
                    <table class="winner-table">
                        <thead>
                        <tr>
                            <th scope="col">Statut</th>
                            <th scope="col">Gagnant</th>
                            <th scope="col" class="winner-table-amount">Mise gagnante</th>
                            <th scope="col" class="winner-table-amount">Versement</th>
                            {% if can_manage_winnings %}<th scope="col">Action</th>{% endif %}
                        </tr>
                        </thead>
                        <tbody>
                {% for winner in winners %}
                    <tr>
                        <td class="winner-status"><span class="stake-payment-status{% if winner.is_winnings_paid %} is-paid{% endif %}">{{ winner.is_winnings_paid ? 'Gain versé' : 'Gain à verser' }}</span></td>
                        <th scope="row" class="winner-name">{{ winner.contact_name }}</th>
                        <td class="winner-table-amount winner-stake" data-label="Mise gagnante">{{ winner.winning_stake|number_format(0, ',', ' ') }} $</td>
                        <td class="winner-table-amount winner-payout" data-label="Versement"><strong>{{ winner.payout|number_format(0, ',', ' ') }} $</strong></td>
                        {% if can_manage_winnings %}
                            <td class="winner-action">
                                <form method="post" action="/bets/{{ bet.id }}/winners/{{ winner.contact_id }}/payment-status">
                                    <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                                    <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                                    <input type="hidden" name="is_paid" value="{{ winner.is_winnings_paid ? '0' : '1' }}">
                                    <button class="button button-secondary" type="submit">{{ winner.is_winnings_paid ? 'Annuler le versement' : 'Marquer versé' }}</button>
                                </form>
                            </td>
                        {% endif %}
                    </tr>
                {% endfor %}
                        </tbody>
                    </table>
                </div>
            {% else %}
                <div class="empty-state"><p>Aucune mise gagnante active.</p></div>
            {% endif %}
        </section>
    {% endif %}

    <section class="bet-card" aria-labelledby="bet-statistics-title">
        <h2 id="bet-statistics-title">Participation</h2>
        {% if statistics.stake_count == 0 %}
            <div class="empty-state"><p>Aucune mise active sur ce pari.</p></div>
        {% else %}
            <div class="bet-statistics-summary">
                <article><strong>{{ statistics.participant_count }}</strong><span>Participants</span></article>
                <article><strong>{{ statistics.pot|number_format(0, ',', ' ') }} $</strong><span>Pot total</span></article>
                <article><strong>{{ statistics.average_stake|number_format(0, ',', ' ') }} $</strong><span>Mise moyenne</span></article>
                <article><strong>{{ (statistics.median_stake_x2 / 2)|number_format(1, ',', ' ') }} $</strong><span>Mise médiane</span></article>
                <article><strong>{{ statistics.largest_stake|number_format(0, ',', ' ') }} $</strong><span>Plus grosse mise</span></article>
            </div>
            <div class="option-distribution">
                {% for option in statistics.options %}
                    <article>
                        <div><strong>{{ option.label }}</strong><span>{{ option.participant_count }} participant{{ option.participant_count > 1 ? 's' : '' }} · {{ option.amount|number_format(0, ',', ' ') }} $</span></div>
                        <div class="distribution-track" aria-hidden="true"><span style="width: {{ option.pot_percentage ?? 0 }}%"></span></div>
                        <strong>{{ option.pot_percentage is null ? '—' : option.pot_percentage|number_format(1, ',', ' ') ~ ' %' }}</strong>
                    </article>
                {% endfor %}
            </div>
        {% endif %}
    </section>
{% endblock %}