<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#172554">
    <title>{% block title %}Gamble{% endblock %}</title>
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<main class="app-shell">
    <nav class="primary-navigation" aria-label="Navigation principale">
        <a class="button button-secondary" href="/">Accueil</a>
        {% if can_view_bets|default(false) %}
            <a class="button button-primary" href="/bets">Paris</a>
        {% endif %}
        {% if can_view_contacts|default(false) %}
            <a class="button button-primary" href="/contacts">Contacts</a>
        {% endif %}
        {% if can_view_groups|default(false) %}
            <a class="button button-primary" href="/groups">Groupes</a>
        {% endif %}
        {% if can_view_statistics|default(false) %}
            <a class="button button-primary" href="/statistics">Statistiques</a>
        {% endif %}
        {% if can_view_users|default(false) %}
            <a class="button button-primary" href="/admin/users">Utilisateurs</a>
        {% endif %}
    </nav>
    {% block content %}{% endblock %}
</main>
</body>
</html>