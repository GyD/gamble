<!doctype html>
<html lang="fr">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#172554">
    <title>{% block title %}{{ app_name|default('Gamble') }}{% endblock %}</title>
    {% block vendor_stylesheets %}{% endblock %}
    <link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<main class="app-shell">
    <div class="navigation-menu">
        <button class="navigation-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
            <span class="navigation-toggle-icon" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </span>
            Menu
        </button>
        <nav class="primary-navigation" id="primary-navigation" aria-label="Navigation principale">
            <a class="button {{ current_path == '/' ? 'button-primary' : 'button-secondary' }}" href="/"{% if current_path == '/' %} aria-current="page"{% endif %}>Accueil</a>
            {% if can_view_bets|default(false) %}
                <a class="button {{ current_path == '/bets' or current_path starts with '/bets/' ? 'button-primary' : 'button-secondary' }}" href="/bets"{% if current_path == '/bets' or current_path starts with '/bets/' %} aria-current="page"{% endif %}>Paris</a>
            {% endif %}
            {% if can_view_contacts|default(false) %}
                <a class="button {{ current_path == '/contacts' or current_path starts with '/contacts/' ? 'button-primary' : 'button-secondary' }}" href="/contacts"{% if current_path == '/contacts' or current_path starts with '/contacts/' %} aria-current="page"{% endif %}>Contacts</a>
            {% endif %}
            {% if can_view_groups|default(false) %}
                <a class="button {{ current_path == '/groups' or current_path starts with '/groups/' ? 'button-primary' : 'button-secondary' }}" href="/groups"{% if current_path == '/groups' or current_path starts with '/groups/' %} aria-current="page"{% endif %}>Groupes</a>
            {% endif %}
            {% if can_view_statistics|default(false) %}
                <a class="button {{ current_path == '/statistics' or current_path starts with '/statistics/' ? 'button-primary' : 'button-secondary' }}" href="/statistics"{% if current_path == '/statistics' or current_path starts with '/statistics/' %} aria-current="page"{% endif %}>Statistiques</a>
            {% endif %}
            {% if can_view_users|default(false) %}
                <a class="button {{ current_path == '/admin/users' or current_path starts with '/admin/users/' ? 'button-primary' : 'button-secondary' }}" href="/admin/users"{% if current_path == '/admin/users' or current_path starts with '/admin/users/' %} aria-current="page"{% endif %}>Utilisateurs</a>
            {% endif %}
        </nav>
        {% if navigation_user|default(null) %}
            <form method="post" action="/auth/logout" class="navigation-logout">
                <input type="hidden" name="{{ navigation_csrf.name_key }}" value="{{ navigation_csrf.name }}">
                <input type="hidden" name="{{ navigation_csrf.value_key }}" value="{{ navigation_csrf.value }}">
                <button type="submit" class="button button-secondary navigation-logout-button" aria-label="Se déconnecter du compte Twitch de {{ navigation_user.twitchDisplayName }}">
                    {% if navigation_user.twitchAvatarUrl %}
                        <img class="navigation-account-avatar" src="{{ navigation_user.twitchAvatarUrl }}" alt="">
                    {% endif %}
                    <span>Se déconnecter</span>
                </button>
            </form>
        {% endif %}
    </div>
    {% block content %}{% endblock %}
</main>
{% block scripts %}{% endblock %}
<script src="/assets/js/navigation-menu.js"></script>
</body>
</html>