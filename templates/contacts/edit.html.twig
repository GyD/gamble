{% extends 'layout.html.twig' %}

{% block title %}Modifier {{ contact.name }} · Gamble{% endblock %}

{% block content %}
    <header class="page-header page-header-row">
        <div>
            <p class="eyebrow">Contacts</p>
            <h1>Modifier</h1>
        </div>
        <a class="button button-secondary" href="/contacts">Retour</a>
    </header>

    <form method="post" action="/contacts/{{ contact.id }}" class="contact-form form-section">
        <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
        <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
        <div class="form-field">
            <label for="contact-name">Nom</label>
            <input id="contact-name" name="name" type="text" maxlength="120" value="{{ contact.name }}" required>
        </div>
        <div class="form-field">
            <label for="contact-phone-number">Numéro de téléphone</label>
            <input id="contact-phone-number" name="phone_number" type="text" inputmode="numeric" pattern="[0-9]{1,4}" maxlength="4" value="{{ contact.phoneNumber }}" required>
        </div>
        <div class="form-field">
            <label for="contact-note">Note <span>(facultative)</span></label>
            <textarea id="contact-note" name="note" maxlength="2000" rows="5">{{ contact.note }}</textarea>
        </div>
        <fieldset class="group-choices">
            <legend>Groupes</legend>
            <p class="form-help">L’appartenance se gère depuis ce contact.</p>
            {% if groups %}
                <div class="choice-grid">
                    {% for group in groups %}
                        <label class="choice-row">
                            <input type="checkbox" name="group_ids[]" value="{{ group.id }}"{% if group.id in selected_group_ids %} checked{% endif %}>
                            <span>
                                <strong>{{ group.name }}</strong>
                                {% if group.archived %}<small>Groupe archivé — vous pouvez retirer ce contact.</small>{% endif %}
                            </span>
                        </label>
                    {% endfor %}
                </div>
            {% else %}
                <p class="form-help">Aucun groupe disponible. Créez d’abord un groupe depuis la page Groupes.</p>
            {% endif %}
        </fieldset>
        <button class="button button-primary" type="submit">Enregistrer</button>
    </form>
{% endblock %}
