{% extends 'layout.html.twig' %}

{% block title %}Mises · {{ bet.question }} · {{ app_name|default('Gamble') }}{% endblock %}

{% block vendor_stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.6.2/dist/css/tom-select.css">
{% endblock %}

{% block content %}
    <header class="page-header page-header-row page-header-back">
        <div><h1>{{ bet.question }}</h1></div>
        <a class="button button-secondary" href="/bets/{{ bet.id }}">Retour</a>
    </header>

    {% if saved %}<p class="notice notice-success" role="status">Modification enregistrée.</p>{% endif %}

    {% set paid_stake_count = 0 %}
    {% set paid_stake_total = 0 %}
    {% set unpaid_stake_count = 0 %}
    {% set unpaid_stake_total = 0 %}
    {% for stake in stakes %}
        {% if stake.isPaid and not stake.isCancelled %}
            {% set paid_stake_count = paid_stake_count + 1 %}
            {% set paid_stake_total = paid_stake_total + stake.amount %}
        {% endif %}
        {% if not stake.isPaid and not stake.isCancelled %}
            {% set unpaid_stake_count = unpaid_stake_count + 1 %}
            {% set unpaid_stake_total = unpaid_stake_total + stake.amount %}
        {% endif %}
    {% endfor %}

    <section class="stake-summary" aria-label="Résumé des mises">
        <article><strong>{{ paid_stake_count }}</strong><span>Mise{{ paid_stake_count > 1 ? 's' : '' }} payée{{ paid_stake_count > 1 ? 's' : '' }}</span></article>
        <article><strong>{{ paid_stake_total|number_format(0, ',', ' ') }} $</strong><span>Pot payé</span></article>
        <article><strong>{{ unpaid_stake_count }}</strong><span>Mise{{ unpaid_stake_count > 1 ? 's' : '' }} non payée{{ unpaid_stake_count > 1 ? 's' : '' }}</span></article>
        <article><strong>{{ unpaid_stake_total|number_format(0, ',', ' ') }} $</strong><span>Pot non payé</span></article>
    </section>

    <div class="stake-layout{% if can_create %} has-create-form{% endif %}">
    {% if can_create %}
        <section class="form-section stake-create-panel">
            <h2>Ajouter une mise</h2>
            {% if contacts is empty %}
                <p class="form-help">Aucun contact actif. Crée ou réactive un contact avant d’ajouter une mise.</p>
            {% else %}
                <form method="post" action="/bets/{{ bet.id }}/stakes" class="stake-form">
                    <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                    <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                    <div class="form-field"><label for="stake-contact">Contact</label><select id="stake-contact" name="contact_id" data-searchable-select data-placeholder="Rechercher un contact…" required><option value="">Sélectionner</option>{% for contact in contacts %}<option value="{{ contact.id }}">{{ contact.name }} · {{ contact.phoneNumber }}{{ contact_groups[contact.id] is defined ? ' · Groupes : ' ~ contact_groups[contact.id]|join(', ') : '' }}</option>{% endfor %}</select></div>
                    <div class="form-field"><label for="stake-option">Choix</label><select id="stake-option" name="bet_option_id" data-stake-option required><option value="">Sélectionner</option>{% for option in bet.options %}<option value="{{ option.id }}"{% if bet.bettingMode.value == 'fixed_odds' %}{% if option.offeredOdds is null %} disabled{% else %} data-odds="{{ option.offeredOdds|number_format(2, '.', '') }}"{% endif %}{% endif %}>{{ option.label }}{% if bet.bettingMode.value == 'fixed_odds' %} — {{ option.offeredOdds is null ? 'non coté' : 'cote ' ~ option.offeredOdds|number_format(2, ',', ' ') }}{% endif %}</option>{% endfor %}</select></div>
                    <div class="form-field"><label for="stake-amount">Montant</label><input id="stake-amount" name="amount" type="number" min="1" max="999999" step="1" inputmode="numeric" data-stake-amount required></div>
                    {% if bet.bettingMode.value == 'fixed_odds' %}
                        <p class="form-help" data-stake-payout aria-live="polite">Choisissez un choix coté et un montant pour voir le gain estimé.</p>
                        <p class="form-help">La cote annoncée est indicative : la cote contractuelle sera figée à l'encaissement de la mise, à celle proposée à ce moment-là.</p>
                    {% endif %}
                    <button class="button button-primary" type="submit">Ajouter</button>
                </form>
            {% endif %}
        </section>
    {% endif %}

    <section class="stake-list-section" aria-labelledby="stake-list-title">
        <div class="stake-list-heading">
            <h2 id="stake-list-title">Mises enregistrées</h2>
            <span>{{ stakes|length }} au total</span>
        </div>
        <div class="stake-list">
        {% for stake in stakes %}
            <article class="stake-card{% if stake.isCancelled %} is-cancelled{% endif %}">
                <header class="stake-card-header">
                    <div>
                        <h3>{{ stake.contactName }}</h3>
                        <p>{{ stake.optionLabel }}</p>
                    </div>
                        <div class="stake-card-amount"><strong>{{ stake.amount|number_format(0, ',', ' ') }} $</strong></div>
                </header>
                <div class="stake-statuses">
                    <span class="stake-payment-status{% if bet.status.value == 'cancelled' and not stake.isPaid %} is-refunded{% elseif stake.isPaid %} is-paid{% endif %}">{{ bet.status.value == 'cancelled' ? (stake.isPaid ? 'À rembourser' : 'Remboursée') : (stake.isPaid ? 'Payée' : 'Non payée') }}</span>
                    {% if stake.isCancelled %}<span class="stake-cancellation-status">Mise annulée</span>{% endif %}
                    {% if stake.contactArchived %}<span class="stake-archived-status">Contact archivé</span>{% endif %}
                </div>
                {#
                    The payout shown follows the existence of a contractual odds,
                    never the payment flag alone: a stake unpaid again, or
                    refunded, keeps the odds captured at its first payment, and
                    paying it again never reprices it.
                #}
                {% if bet.bettingMode.value == 'fixed_odds' %}
                    {% if stake.hasContractualOdds %}
                        <p class="form-help">
                            Cote contractuelle : {{ stake.oddsAtBet|number_format(2, ',', ' ') }} — figée au premier encaissement de la mise. Gain garanti si gagnant : {{ stake.potentialPayout|number_format(0, ',', ' ') }} $.
                            {% if not stake.isPaid %}Cette mise n'est plus encaissée, mais sa cote reste acquise : un nouvel encaissement ne la recotera pas.{% endif %}
                        </p>
                    {% elseif stake.isPaid %}
                        <p class="form-help">Aucune cote contractuelle : cette mise sera remboursée à hauteur de son montant si elle gagne.</p>
                    {% else %}
                        {#
                            The unpaid stake has no contract yet: it is projected at
                            the odds it would actually capture, its own influence
                            excluded. The public odds are only shown as context, and
                            never as the price this stake would obtain.
                        #}
                        {% set stake_option = bet.options|filter(option => option.id == stake.betOptionId)|first %}
                        {% set public_odds = stake_option ? stake_option.offeredOdds : null %}
                        {% set quoted_payment_odds = payment_odds|default({}) %}
                        {% set settlement_odds = quoted_payment_odds[stake.id] is defined ? quoted_payment_odds[stake.id] : public_odds %}
                        <p class="form-help">
                            {{ stake.quotedOdds is null ? 'Aucune cote annoncée à la prise de la mise.' : 'Cote annoncée à la prise : ' ~ stake.quotedOdds|number_format(2, ',', ' ') ~ '.' }}
                            {{ settlement_odds is null ? 'Ce choix n\'est plus coté : à l\'encaissement, la mise serait simplement remboursée si elle gagne.' : 'Cote si encaissée maintenant : ' ~ settlement_odds|number_format(2, ',', ' ') ~ ' — gain estimé si encaissée maintenant et gagnante : ' ~ stake.payoutAt(settlement_odds)|number_format(0, ',', ' ') ~ ' $.' }}
                            {% if settlement_odds is not null and public_odds is not null and public_odds != settlement_odds %}Cote publique proposée aux nouvelles mises : {{ public_odds|number_format(2, ',', ' ') }} — elle inclut l'influence de cette mise, qui ne s'applique pas à elle-même.{% endif %}
                        </p>
                        <p class="form-help">Rien n'est encore contractuel : la cote sera figée au moment de l'encaissement, à celle proposée alors, hors influence de cette mise.</p>
                    {% endif %}
                {% endif %}
                {% if stake.finalPayout is not null %}
                    <p class="stake-payout"><span>Gain final</span><strong>{{ stake.finalPayout|number_format(0, ',', ' ') }} $</strong></p>
                {% endif %}
                {% if can_edit and not stake.contactArchived and not stake.isCancelled %}
                    <form id="stake-edit-{{ stake.id }}" method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}" class="stake-form">
                        <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                        <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                        <div class="form-field"><label for="contact-{{ stake.id }}">Contact</label><select id="contact-{{ stake.id }}" name="contact_id" data-searchable-select data-placeholder="Rechercher un contact…" required>{% for contact in contacts %}<option value="{{ contact.id }}"{% if contact.id == stake.contactId %} selected{% endif %}>{{ contact.name }} · {{ contact.phoneNumber }}{{ contact_groups[contact.id] is defined ? ' · Groupes : ' ~ contact_groups[contact.id]|join(', ') : '' }}</option>{% endfor %}</select></div>
                        <div class="form-field"><label for="option-{{ stake.id }}">Choix</label><select id="option-{{ stake.id }}" name="bet_option_id" required>{% for option in bet.options %}<option value="{{ option.id }}"{% if option.id == stake.betOptionId %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select></div>
                                    <input id="stake-amount-{{ stake.id }}" name="amount" type="number" min="1" max="999999" step="1" inputmode="numeric" value="{{ stake.amount }}" required>
                    </form>
                {% else %}
                    {% if contact_groups[stake.contactId] is defined %}<p class="form-help">Groupes : {{ contact_groups[stake.contactId]|join(', ') }}</p>{% endif %}
                    {% if stake.contactArchived %}<p class="form-help">Contact archivé : cette mise reste consultable mais ne peut plus être modifiée.</p>{% endif %}
                    {% if stake.isCancelled %}<p class="form-help">Cette mise est annulée. Réactive-la pour pouvoir la modifier.</p>{% endif %}
                {% endif %}
                {% if (can_edit and not stake.contactArchived and (not stake.isCancelled or stake.isPaid)) or can_delete %}
                    <div class="stake-actions">
                        {% if can_edit and not stake.contactArchived and not stake.isCancelled %}
                            <button class="button button-primary" type="submit" form="stake-edit-{{ stake.id }}">Enregistrer</button>
                            <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/payment-status">
                                <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                                <input type="hidden" name="is_paid" value="{{ stake.isPaid ? '0' : '1' }}">
                                <button class="button button-secondary" type="submit">{{ stake.isPaid ? 'Non payée' : 'Payée' }}</button>
                            </form>
                        {% elseif can_edit and not stake.contactArchived and stake.isCancelled and stake.isPaid %}
                            <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/payment-status">
                                <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                                <input type="hidden" name="is_paid" value="0">
                                <button class="button button-secondary" type="submit">Marquer remboursée</button>
                            </form>
                        {% endif %}
                        {% if can_delete %}
                            <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/cancellation-status">
                                <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                                <input type="hidden" name="is_cancelled" value="{{ stake.isCancelled ? '0' : '1' }}">
                                <button class="button button-secondary" type="submit">{{ stake.isCancelled ? 'Réactiver' : 'Annuler' }}</button>
                            </form>
                        {% endif %}
                        {% if can_delete and stake.isCancelled and not stake.isPaid %}
                            <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/delete">
                                <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                                <button class="button button-danger" type="submit" onclick="return confirm('Supprimer cette mise ?')">Supprimer</button>
                            </form>
                        {% endif %}
                    </div>
                {% endif %}
                {% if can_refund and (not stake.isCancelled or stake.isPaid) %}
                    <div class="stake-actions">
                        <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/refund-status">
                            <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                            <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                            <input type="hidden" name="is_refunded" value="{{ stake.isPaid ? '1' : '0' }}">
                            <button class="button {{ stake.isPaid ? 'button-primary' : 'button-secondary' }}" type="submit">{{ stake.isPaid ? 'Marquer remboursée' : 'Annuler le remboursement' }}</button>
                        </form>
                    </div>
                {% endif %}
            </article>
        {% else %}
            <section class="empty-state"><p>Aucune mise.</p></section>
        {% endfor %}
        </div>
    </section>
    </div>
{% endblock %}

{% block scripts %}
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.6.2/dist/js/tom-select.complete.min.js" defer></script>
    <script src="/assets/js/searchable-selects.js" defer></script>
    <script src="/assets/js/stake-payout.js" defer></script>
{% endblock %}