{% extends 'layout.html.twig' %}

{% block title %}Mises · {{ bet.question }} · {{ app_name|default('Gamble') }}{% endblock %}

{% block vendor_stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/tom-select@2.6.2/dist/css/tom-select.css">
{% endblock %}

{% block content %}
    <header class="page-header page-header-row page-header-back">
        <div><h1>{{ bet.question }}</h1></div>
        <a class="button button-secondary" href="/bets/{{ bet.id }}">Retour</a>
    </header>

    {% if saved %}<p class="notice notice-success" role="status">Modification enregistrée.</p>{% endif %}

    <div class="stake-layout{% if can_create %} has-create-form{% endif %}">
    {% if can_create %}
        <section class="form-section stake-create-panel">
            <h2>Ajouter une mise</h2>
            {% if contacts is empty %}
                <p class="form-help">Aucun contact actif. Crée ou réactive un contact avant d’ajouter une mise.</p>
            {% else %}
                <form method="post" action="/bets/{{ bet.id }}/stakes" class="stake-form">
                    <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                    <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                    <div class="form-field"><label for="stake-contact">Contact</label><select id="stake-contact" name="contact_id" data-searchable-select data-placeholder="Rechercher un contact…" required><option value="">Sélectionner</option>{% for contact in contacts %}<option value="{{ contact.id }}">{{ contact.name }} · {{ contact.phoneNumber }} · {{ contact_groups[contact.id] is defined ? 'Groupes : ' ~ contact_groups[contact.id]|join(', ') : 'Sans groupe' }}</option>{% endfor %}</select></div>
                    <div class="form-field"><label for="stake-option">Choix</label><select id="stake-option" name="bet_option_id" required><option value="">Sélectionner</option>{% for option in bet.options %}<option value="{{ option.id }}">{{ option.label }}</option>{% endfor %}</select></div>
                    <div class="form-field"><label for="stake-amount">Montant</label><input id="stake-amount" name="amount" type="number" min="0.01" max="999999.99" step="0.01" inputmode="decimal" required></div>
                    <button class="button button-primary" type="submit">Ajouter</button>
                </form>
            {% endif %}
        </section>
    {% endif %}

    <div class="stake-list">
        {% for stake in stakes %}
            <article class="stake-card{% if stake.isCancelled %} is-cancelled{% endif %}">
                {% if stake.isCancelled %}<p class="stake-cancellation-status">Annulée</p>{% endif %}
                <p class="stake-payment-status{% if bet.status.value == 'cancelled' and not stake.isPaid %} is-refunded{% elseif stake.isPaid %} is-paid{% endif %}">{{ bet.status.value == 'cancelled' ? (stake.isPaid ? 'À rembourser' : 'Remboursée') : (stake.isPaid ? 'Payée' : 'Non payée') }}</p>
                {% if can_edit and not stake.contactArchived and not stake.isCancelled %}
                    <form id="stake-edit-{{ stake.id }}" method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}" class="stake-form">
                        <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                        <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                        <div class="form-field"><label for="contact-{{ stake.id }}">Contact</label><select id="contact-{{ stake.id }}" name="contact_id" data-searchable-select data-placeholder="Rechercher un contact…" required>{% for contact in contacts %}<option value="{{ contact.id }}"{% if contact.id == stake.contactId %} selected{% endif %}>{{ contact.name }} · {{ contact.phoneNumber }} · {{ contact_groups[contact.id] is defined ? 'Groupes : ' ~ contact_groups[contact.id]|join(', ') : 'Sans groupe' }}</option>{% endfor %}</select></div>
                        <div class="form-field"><label for="option-{{ stake.id }}">Choix</label><select id="option-{{ stake.id }}" name="bet_option_id" required>{% for option in bet.options %}<option value="{{ option.id }}"{% if option.id == stake.betOptionId %} selected{% endif %}>{{ option.label }}</option>{% endfor %}</select></div>
                        <div class="form-field"><label for="amount-{{ stake.id }}">Montant</label><input id="amount-{{ stake.id }}" name="amount" type="number" min="0.01" max="999999.99" step="0.01" inputmode="decimal" value="{{ '%.2f'|format(stake.amountCents / 100) }}" required></div>
                    </form>
                {% else %}
                    <h2>{{ stake.contactName }}</h2>
                    <p class="form-help">{{ contact_groups[stake.contactId] is defined ? 'Groupes : ' ~ contact_groups[stake.contactId]|join(', ') : 'Sans groupe' }}</p>
                    <p>{{ stake.optionLabel }}</p>
                    <p class="stake-amount">{{ '%.2f'|format(stake.amountCents / 100) }} $</p>
                    {% if stake.contactArchived %}<p class="form-help">Contact archivé : cette mise reste consultable mais ne peut plus être modifiée.</p>{% endif %}
                    {% if stake.isCancelled %}<p class="form-help">Cette mise est annulée. Réactive-la pour pouvoir la modifier.</p>{% endif %}
                {% endif %}
                {% if (can_edit and not stake.contactArchived and (not stake.isCancelled or stake.isPaid)) or can_delete %}
                    <div class="stake-actions">
                        {% if can_edit and not stake.contactArchived and not stake.isCancelled %}
                            <button class="button button-primary" type="submit" form="stake-edit-{{ stake.id }}">Enregistrer</button>
                            <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/payment-status">
                                <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                                <input type="hidden" name="is_paid" value="{{ stake.isPaid ? '0' : '1' }}">
                                <button class="button button-secondary" type="submit">{{ stake.isPaid ? 'Non payée' : 'Payée' }}</button>
                            </form>
                        {% elseif can_edit and not stake.contactArchived and stake.isCancelled and stake.isPaid %}
                            <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/payment-status">
                                <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                                <input type="hidden" name="is_paid" value="0">
                                <button class="button button-secondary" type="submit">Marquer remboursée</button>
                            </form>
                        {% endif %}
                        {% if can_delete %}
                            <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/cancellation-status">
                                <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                                <input type="hidden" name="is_cancelled" value="{{ stake.isCancelled ? '0' : '1' }}">
                                <button class="button button-secondary" type="submit">{{ stake.isCancelled ? 'Réactiver' : 'Annuler' }}</button>
                            </form>
                        {% endif %}
                        {% if can_delete and stake.isCancelled and not stake.isPaid %}
                            <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/delete">
                                <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                                <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                                <button class="button button-danger" type="submit" onclick="return confirm('Supprimer cette mise ?')">Supprimer</button>
                            </form>
                        {% endif %}
                    </div>
                {% endif %}
                {% if can_refund and (not stake.isCancelled or stake.isPaid) %}
                    <div class="stake-actions">
                        <form method="post" action="/bets/{{ bet.id }}/stakes/{{ stake.id }}/refund-status">
                            <input type="hidden" name="{{ csrf.name_key }}" value="{{ csrf.name }}">
                            <input type="hidden" name="{{ csrf.value_key }}" value="{{ csrf.value }}">
                            <input type="hidden" name="is_refunded" value="{{ stake.isPaid ? '1' : '0' }}">
                            <button class="button {{ stake.isPaid ? 'button-primary' : 'button-secondary' }}" type="submit">{{ stake.isPaid ? 'Marquer remboursée' : 'Annuler le remboursement' }}</button>
                        </form>
                    </div>
                {% endif %}
            </article>
        {% else %}
            <section class="empty-state"><p>Aucune mise.</p></section>
        {% endfor %}
    </div>
    </div>
{% endblock %}

{% block scripts %}
    <script src="https://cdn.jsdelivr.net/npm/tom-select@2.6.2/dist/js/tom-select.complete.min.js" defer></script>
    <script src="/assets/js/searchable-selects.js" defer></script>
{% endblock %}