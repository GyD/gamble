{
    "name": "gamble/gamble",
    "description": "Self-hosted bet management application",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "ext-curl": "*",
        "ext-pdo": "*",
        "monolog/monolog": "^3.0",
        "php-di/php-di": "^7.0",
        "slim/csrf": "^1.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "twig/twig": "^3.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "migrate": "php bin/migrate",
        "promote-admin": "php bin/promote-admin"
    },
    "config": {
        "allow-plugins": {},
        "optimize-autoloader": true,
        "sort-packages": true
    }
}